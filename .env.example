NODE_ENV=production
PORT=3000
VITE_BUILD_LABEL=Versión v0.2.0 · 13/08/2026 16:50

# Base de datos EXCLUSIVA del TPV; no reutilizar la DATABASE_URL del hostel
DATABASE_URL=mysql://sweet_admin:REPLACE_WITH_PRODUCTION_PASSWORD@localhost:3306/sweet-salty
DB_CONNECTION_LIMIT=5
BUSINESS_TIMEZONE=Europe/Madrid
VITE_APP_TITLE=Sweet & Salty POS
VITE_APP_ID=sweet-salty
OAUTH_SERVER_URL=https://sweetsalty.thespotcentralhostel.com
UPLOADS_DIR=uploads

# Acceso único compartido para el equipo; no hay roles operativos en esta versión
POS_BASIC_USER=sweetsalty
POS_BASIC_PASSWORD=CHANGE_ME

# IA para reconocimiento de facturas (opcional en la primera instalación)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Puente opcional para impresora ESC/POS y cajón de efectivo conectado.
# Debe aceptar POST {"action":"open-drawer","reason":"cash_sale"|"manual"}.
CASH_DRAWER_BRIDGE_URL=
CASH_DRAWER_BRIDGE_TOKEN=
OPENAI_INVOICE_MODEL=gpt-5-mini

# Envío opcional de recibos por correo; si se dejan vacías, el envío permanece desactivado
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Preparación fiscal: la remisión real a AEAT queda bloqueada
AEAT_SUBMISSION_ENABLED=false

# Integración de Loyverse en modo solo lectura. Nunca expongas el token al navegador.
LOYVERSE_API_BASE_URL=https://api.loyverse.com/v1.0
LOYVERSE_API_TOKEN=
# Opcional: UUID de la tienda de Loyverse que se mostrará como tienda activa.
LOYVERSE_STORE_ID=
