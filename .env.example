NODE_ENV=production
PORT=3010
VITE_BUILD_LABEL=Versión v0.2.0 · 13/08/2026 16:50

# Base de datos EXCLUSIVA del TPV; no reutilizar la DATABASE_URL del hostel
DATABASE_URL=mysql://sweetsalty_user:CHANGE_ME@localhost:3306/sweetsalty_pos
DB_CONNECTION_LIMIT=5
BUSINESS_TIMEZONE=Atlantic/Canary
UPLOADS_DIR=uploads

# Acceso único compartido para el equipo; no hay roles operativos en esta versión
POS_BASIC_USER=sweetsalty
POS_BASIC_PASSWORD=CHANGE_ME

# IA para reconocimiento de facturas (opcional en la primera instalación)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Puente opcional para impresora ESC/POS y cajón de efectivo conectado.
# Debe aceptar POST {"action":"open-drawer","reason":"cash_sale"|"manual"}.
CASH_DRAWER_BRIDGE_URL=
CASH_DRAWER_BRIDGE_TOKEN=
OPENAI_INVOICE_MODEL=gpt-5-mini
